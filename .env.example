# Approved production target: https://bukanpipe.com
# Set explicitly on each environment — do not rely on VERCEL_URL for canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing stays false for local and preview. Vercel Production must set:
# NEXT_PUBLIC_ALLOW_INDEXING=true
NEXT_PUBLIC_ALLOW_INDEXING=false

# Legacy path redirects derived from data/migration/legacy-urls.ts.
# Enable on Vercel Production after destination pages exist (already true in prod).
# Keep false locally and on preview deployments.
ENABLE_LEGACY_REDIRECTS=false
