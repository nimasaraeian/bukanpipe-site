# Local and preview origin used for canonical URLs during development.
# Approved production target: https://bukanpipe.com
# Do not point preview deployments at the production origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing stays false for local, preview, and staging until explicit launch approval.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Legacy path redirects derived from data/migration/legacy-urls.ts.
# MUST remain false until destination pages exist, Search Console is reviewed,
# and host/domain control is confirmed. Do not enable on preview.
ENABLE_LEGACY_REDIRECTS=false
