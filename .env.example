# Approved production target: https://bukanpipe.com
# Set explicitly on each environment — do not rely on VERCEL_URL for canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing stays false for local and preview. Vercel Production must set:
# NEXT_PUBLIC_ALLOW_INDEXING=true
NEXT_PUBLIC_ALLOW_INDEXING=false

# Legacy inventory redirects (data/migration/legacy-urls.ts) only. The
# historical URL map in redirect-map-draft.csv is always on and ignores this.
ENABLE_LEGACY_REDIRECTS=false

# --- Lead pipeline (server-side) ---
LEADS_API_ENABLED=true
LEADS_PERSISTENCE_ENABLED=false

# Optional UI kill-switch. Commercial submit is enabled unless this is false.
NEXT_PUBLIC_LEADS_SUBMISSION_READY=true

# Telegram Bot (SERVER ONLY — never NEXT_PUBLIC_)
# Enabled automatically when bot token + chat id are set, unless this is false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Optional verified public contact URL (https://t.me/username) — not a secret
TELEGRAM_PUBLIC_URL=
NEXT_PUBLIC_TELEGRAM_CONTACT_URL=

# SMS — FarazSMS / IranPayamak (SERVER ONLY — never NEXT_PUBLIC_)
# POST https://api.iranpayamak.com/ws/v1/sms/simple
# Enabled automatically when provider + API key + sender are set, unless this is false.
SMS_NOTIFICATIONS_ENABLED=true
SMS_PROVIDER=farazsms
SMS_API_KEY=
SMS_SENDER=90008361
SMS_SALES_RECIPIENT=09143820556
